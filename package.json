{
  "name": "wuzzy",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "bun --watch apps/backend/src/main.ts",
    "dev:frontend": "bun apps/frontend/build.ts --watch --serve",
    "build:frontend": "bun apps/frontend/build.ts",
    "test": "bun test",
    "scenarios": "bun scripts/scenario-report.ts",
    "typecheck": "bunx tsc --noEmit",
    "wuzzy": "bun apps/backend/src/cli/wuzzy.ts",
    "demo": "bun apps/demo-agent/src/main.ts",
    "demo:embeddings": "bun scripts/demo/stub-embeddings.ts",
    "demo:facilitator": "bun scripts/demo/mock-facilitator.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.8.0"
  }
}
