# Backend
PORT=3000

# Postgres (TypeORM + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# Run pending migrations on startup. Off by default; prefer a dedicated
# `bun run migration:run` step for multi-replica deploys. See README.
# DB_MIGRATIONS_RUN=true

# Crawler identity. Wuzzy crawls in the open: this user-agent goes out on every
# request the crawler makes, robots.txt included. Never change it to impersonate
# a browser — see CLAUDE.md.
WUZZY_USER_AGENT="WuzzyBot/1.0 (+https://wuzzy.io/bot)"

# Embeddings (any OpenAI-compatible endpoint). The dimension must match the
# vector(1536) column in the schema.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# x402 meter. Off means /search is open, which is a development-only setting.
# PAY_TO is a receiving address only: no key for it belongs on this machine.
X402_ENABLED=true
X402_NETWORK=base
X402_PRICE=$0.01
X402_PAY_TO=
X402_FACILITATOR_URL=https://x402.org/facilitator
