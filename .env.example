# Backend
PORT=3000

# Postgres (TypeORM + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# Run pending migrations on startup. Off by default; prefer a dedicated
# `bun run migration:run` step for multi-replica deploys. See README.
# DB_MIGRATIONS_RUN=true

# Redis, the broker for the crawl queue. A commissioned crawl is enqueued the
# moment its payment settles, and a worker drains it. The queue is a trigger
# and never the record: what is owed is `index_urls` rows with a null
# `crawled_at`, so an unreachable Redis delays a crawl and cannot lose one.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Crawler identity. Wuzzy crawls in the open: this user-agent goes out on every
# request the crawler makes, robots.txt included. Never change it to impersonate
# a browser — see CLAUDE.md.
WUZZY_USER_AGENT="WuzzyBot/1.0 (+https://wuzzy.io/bot)"
# Re-fetch a page after this long even when its sitemap says nothing changed.
# lastmod is self-reported and often a build timestamp, so it is believed only
# in the direction that does less work; this is the backstop for a site whose
# lastmod never moves. `wuzzy crawl --all` ignores freshness entirely.
# CRAWL_MAX_AGE_DAYS=14

# Embeddings (any OpenAI-compatible endpoint). The dimension must match the
# vector(1536) column in the schema.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# x402 meter. Off means /search is open, which is a development-only setting.
# PAY_TO is a receiving address only: no key for it belongs on this machine.
X402_ENABLED=true
# Set to base-sepolia alongside EAS_CHAIN for a testnet rehearsal.
X402_NETWORK=base
X402_PRICE=$0.01
X402_PAY_TO=
# Coinbase's facilitator is the one that settles on Base mainnet, and it needs
# credentials. The public endpoint at x402.org settles testnets only: asking it
# what it supports returns base-sepolia and no eip155:8453, so a mainnet
# deployment pointed there 402s forever. Leave the URL unset to use Coinbase's.
# X402_FACILITATOR_URL=
X402_CDP_API_KEY_ID=
X402_CDP_API_KEY_SECRET=

# EAS attestation. The schema is registered once by hand; the UID lands here.
# ATTESTER_PRIVATE_KEY is deliberately absent: `wuzzy attest` is run by a human
# in their own environment, never by CI or an agent.
#
# EAS_CHAIN picks the network and everything that follows from it: the RPC and
# the easscan host a result's provenance block links to. One setting, because
# attesting on one network while linking readers to another's explorer makes
# every result look unverifiable. Use base-sepolia to rehearse the whole loop
# with testnet funds; the schema must be registered separately on each network.
EAS_CHAIN=base
# Overrides only the endpoint, never which chain is attested to.
# BASE_RPC_URL=
EAS_SCHEMA_UID=
# ATTESTER_PRIVATE_KEY=   # never commit, never set on a shared machine

# Read-only admin view of the index at /admin. Opt-in: it exposes crawl errors,
# fetch history and skip reasons. When ADMIN_TOKEN is set, requests must carry
# it as the x-admin-token header; when it is unset there is no auth at all, so
# only leave it unset on something bound to localhost.
ADMIN_ENABLED=false
# ADMIN_TOKEN=

# Search. Hybrid runs BM25 and vector similarity independently and fuses their
# rankings with Reciprocal Rank Fusion; `lexical` needs no embedding provider at
# all, and `vector` is the old pure-embedding behaviour.
SEARCH_MODE=hybrid
# Candidates each arm contributes before fusion. Deeper than topK on purpose.
SEARCH_CANDIDATES=50
# RRF damping. 60 is the value from the original paper.
SEARCH_RRF_K=60
# BM25 term-frequency saturation and length normalisation.
SEARCH_BM25_K1=1.2
SEARCH_BM25_B=0.75
# Scoped chunk count at or below which the vector arm scans exhaustively rather
# than through the approximate index, which filters after it searches.
SEARCH_EXACT_SCAN_CHUNKS=20000

# Free web search. The box on the public site posts here, because a browser
# cannot sign an x402 payment. It is a separate route from /search on purpose:
# the metered path's scenarios are a contract, and nothing here touches them.
#
# Opt-in, unlike the meter's opt-out. A free route beside a metered one gives
# the index away, so forgetting to set this must leave it closed; a disabled
# instance answers 404 rather than 403, so it does not advertise itself. It
# reads the global index only and takes no index parameter, because access
# control rides x402 and there is no payer here to check.
WEB_SEARCH_ENABLED=false
# Origins allowed to call it from a browser, comma separated. Only needed for a
# cross-origin call: the site's own nginx proxies /api on the same origin.
WEB_SEARCH_ORIGINS=https://wuzzy.io
# Requests per window per client, and the window in milliseconds.
WEB_SEARCH_RATE_LIMIT=10
WEB_SEARCH_RATE_WINDOW_MS=60000
# Trusted proxies in front of this process, used to pick the client address out
# of X-Forwarded-For counting from the right. 1 for nginx alone, 2 behind a CDN,
# 0 when nothing fronts it. The leftmost entry is caller-supplied and is never
# trusted, or anyone could invent an address per request.
WEB_SEARCH_PROXY_HOPS=1
# How long a shared cache may reuse a response.
WEB_SEARCH_CACHE_SECONDS=60

# Frontend, read at BUILD time by apps/frontend/src/site.config.ts and baked
# into the static HTML. Changing one means rebuilding the image, so they are
# Docker build args rather than container environment. See apps/frontend/Dockerfile.
# SITE_ORIGIN=https://wuzzy.io
# API_ORIGIN=https://api.wuzzy.io
# Renders the free search box. Needs WEB_SEARCH_ENABLED above to match.
# SEARCH_ENABLED=false
# Receipts that do not exist until they are registered. Absent, the page says
# "published at cutover" rather than rendering a dead link.
# EAS_SCHEMA_URL=
# BAZAAR_URL=

# Indexes. Every index is the same primitive configured differently; "global" is
# the one an unscoped /search reads, owned by the operator wallet.
WUZZY_GLOBAL_INDEX_SLUG=global
# Address that owns the global index. Never a key, only an address: attesting
# and settling are done elsewhere by a human.
# WUZZY_OPERATOR_WALLET=
# Maximum URLs one request may carry. A transport bound, not a product one: the
# body is parsed before the payment is checked, so this is what limits what an
# unpaid caller can make the server read. The accepted body size is derived
# from it. Asking for more pages is not refused, it is split across requests.
# WUZZY_INDEX_REQUEST_URL_LIMIT=2000
# Maximum pages an index may hold in total. Unset means no limit, which is the
# default: there is no reason to stop someone buying more of what they are
# paying for, and per-host request spacing is what keeps the crawl polite. Set
# it only to bound a deployment deliberately.
# WUZZY_INDEX_PAGE_CAP=
# Charged per page at creation and on every append. It buys the crawl and the
# onchain attestation together: every page commissioned here is attested, so
# the price has to cover gas. At the gas in SCHEMA.md a receipt is a bit over
# half a cent, and two cents leaves headroom for Base's fee market to move.
WUZZY_INDEX_PRICE_PER_PAGE=$0.02
