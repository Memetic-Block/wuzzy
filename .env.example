# Backend
PORT=3000

# Postgres (TypeORM) — remove if the database module is removed
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
# Auto-create the schema from entities. Defaults on outside production; set
# explicitly to override. Real projects should use migrations instead.
# DB_SYNCHRONIZE=true
# Run pending migrations on startup. Off by default; prefer a dedicated
# `bun run migration:run` step for multi-replica deploys. See README.
# DB_MIGRATIONS_RUN=true

# Redis (BullMQ) — remove if the queue module is removed
REDIS_HOST=localhost
REDIS_PORT=6379
