    "@nestjs/typeorm": "^11.0.0",
    "crawlee": "^3.18.1",
    "ethers": "^6.17.0",
    "jsdom": "^30.0.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "turndown": "^7.2.4",
